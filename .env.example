# Copy to .env and fill in. Never commit .env.

# --- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Reasoning effort: none, low, medium, high. low keeps first words under ~2 s.
# Leave empty for models without reasoning (e.g. gpt-4.1-mini).
OPENAI_REASONING_EFFORT=low

# --- Security ---------------------------------------------------------------
# Long random string; set the same value as AGENT_API_KEY in the website's env.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=
# Bearer token for /v1/admin/leads and /v1/admin/conversations/{id}
ADMIN_TOKEN=

# --- Lead dashboard ---------------------------------------------------------
# Admin login, written by `python -m app.crm.seed` (re-run it to reset the password).
# Password: 12+ characters. Never commit the real values.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Shared secret for POST /api/leads/ingest (header X-Ingest-Key). Empty disables the endpoint.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_KEY=
INGEST_RATE_PER_MINUTE=30
# Origin(s) of the dashboard, comma separated. The only origins allowed to call /api.
DASHBOARD_ORIGINS=http://localhost:5173
# Session cookie over HTTPS only. Set false for plain-http local development.
COOKIE_SECURE=true
SESSION_DAYS=7
# true when behind Caddy/nginx: take the client IP from X-Forwarded-For (login lockout, ingest limit)
TRUST_PROXY=false
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# --- Storage ----------------------------------------------------------------
# Default: SQLite file in ./data. For Postgres: postgresql+asyncpg://user:pass@host/db
# DATABASE_URL=

# --- Cal.com (in-chat booking) ----------------------------------------------
# Settings > Developer > API keys
CAL_API_KEY=
# The numeric id of your "Free growth call" event type (30 minutes)
CAL_EVENT_TYPE_ID=
# Public booking page, shared when in-chat booking is off or fails
CAL_BOOKING_URL=https://cal.com/your-username/growth-call

# --- Email (contact form, lead alerts, briefs) ------------------------------
# Gmail: SMTP_USER is your Gmail address. SMTP_PASSWORD is a 16-character
# App Password (Google Account > Security > 2-Step Verification > App passwords,
# or myaccount.google.com/apppasswords), NOT your normal Gmail password.
SMTP_USER=
SMTP_PASSWORD=
# Optional. Defaults: Gmail's server, sending as SMTP_USER, alerts to SMTP_USER.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_FROM=Scalryx <you@gmail.com>
# OWNER_EMAIL=where-alerts-go@example.com
OWNER_TIMEZONE=America/New_York
# Used when a visitor's own time zone is unknown
DEFAULT_TIMEZONE=America/New_York

# --- Limits -----------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=12
MAX_USER_TURNS=40
